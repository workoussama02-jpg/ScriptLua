# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# Application Environment
NODE_ENV=development

# Clerk Authentication
# Get these from: https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_bWVhc3VyZWQtamFndWFyLTcuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_DOMAIN=your_clerk_domain_here  # e.g., your-app.clerk.accounts.dev
# Supabase Database
# Get these from: https://supabase.com/dashboard
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Discord Webhooks for Ticket Notifications
# Create webhooks in Discord Server Settings > Integrations > Webhooks
# Moderator channel webhook (for new tickets and claims)
DISCORD_WEBHOOK_MODERATOR=https://discord.com/api/webhooks/YOUR_MODERATOR_WEBHOOK_ID/YOUR_MODERATOR_WEBHOOK_TOKEN
# Admin channel webhook (for escalations after 30+ minutes)
DISCORD_WEBHOOK_ADMIN=https://discord.com/api/webhooks/YOUR_ADMIN_WEBHOOK_ID/YOUR_ADMIN_WEBHOOK_TOKEN
# Discord role IDs to mention in notifications (get from Discord Developer Portal)
DISCORD_ROLE_ID=your_moderator_role_id_here
DISCORD_ADMIN_ROLE_ID=your_admin_role_id_here

# Optional: Analytics
GOOGLE_ANALYTICS_ID=

# Site Configuration
SITE_URL=http://localhost:3000
